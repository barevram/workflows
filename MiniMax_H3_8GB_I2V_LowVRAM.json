{
  "1": { "class_type": "UNETLoader", "inputs": { "unet_name": "minimax_h3_fl2va_pruned_int8_convrot.safetensors", "weight_dtype": "default" } },
  "2": { "class_type": "LoraLoaderModelOnly", "inputs": { "model": ["1", 0], "lora_name": "minimax_h3_turbo_v4_step600_ema_pruned_comfyui.safetensors", "strength_model": 1 } },
  "3": { "class_type": "CLIPLoader", "inputs": { "clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default" } },
  "4": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_video_vae_int8_convrot.safetensors" } },
  "5": { "class_type": "VAELoader", "inputs": { "vae_name": "minimax_h3_audio_vae_fp32.safetensors" } },
  "6": { "class_type": "LoadImage", "inputs": { "image": "{{IMAGE}}" } },
  "8": { "class_type": "BasicScheduler", "inputs": { "model": ["2", 0], "scheduler": "simple", "steps": "{{STEPS}}", "denoise": 1 } },
  "10": { "class_type": "RandomNoise", "inputs": { "noise_seed": "{{SEED}}" } },
  "12": { "class_type": "KSamplerSelect", "inputs": { "sampler_name": "res_multistep" } },
  "18": { "class_type": "MiniMaxLowVRAMAttention", "inputs": { "model": ["2", 0], "head_chunks": 4 } },
  "19": { "class_type": "MiniMaxChunkFeedForward", "inputs": { "model": ["18", 0], "chunks": 2, "seq_threshold": 4096 } },
  "20": { "class_type": "BlockSparseAttention", "inputs": { "model": ["19", 0], "selection": "sol-attn", "selection.tau": 1.3, "start_percent": 0.2, "end_percent": 1, "dense_blocks": "", "min_tokens": 12288, "extra_tokens": 256, "sink_conditioning": "exact_kv_and_rows", "verbose": false } },
  "10002": { "class_type": "MiniMaxH3ImageToVideo", "inputs": { "clip": ["3", 0], "vae": ["4", 0], "prompt": "{{PROMPT}}", "width": "{{WIDTH}}", "height": "{{HEIGHT}}", "length": "{{FRAMES}}", "first_frame": ["6", 0] } },
  "10004": { "class_type": "BasicGuider", "inputs": { "model": ["20", 0], "conditioning": ["10002", 0] } },
  "10005": { "class_type": "SamplerCustomAdvanced", "inputs": { "noise": ["10", 0], "guider": ["10004", 0], "sampler": ["12", 0], "sigmas": ["8", 0], "latent_image": ["10002", 1] } },
  "10006": { "class_type": "VRAM_Debug", "inputs": { "empty_cache": true, "gc_collect": true, "unload_all_models": true, "any_input": ["10005", 0] } },
  "10007": { "class_type": "VAEDecode", "inputs": { "samples": ["10006", 0], "vae": ["4", 0] } },
  "10008": { "class_type": "VAEDecodeAudio", "inputs": { "samples": ["10006", 0], "vae": ["5", 0] } },
  "10009": { "class_type": "CreateVideo", "inputs": { "images": ["10007", 0], "fps": 24, "audio": ["10008", 0] } },
  "10010": { "class_type": "SaveVideo", "inputs": { "video": ["10009", 0], "filename_prefix": "{{PREFIX}}", "format": "mp4", "codec": "h264" } }
}
